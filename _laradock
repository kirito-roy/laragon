#compdef laradock

_laradock() {
    local -a commands
    commands=(
        'list:List active projects and their PHP versions'
        'add:Register a new local project site'
        'remove:Deregister a project site'
        'up:Start all LaraDock containers in background'
        'down:Stop and remove all containers'
        'restart:Restart all or a specific service'
        'ssh:Shell instantly into a running container'
        'trust:Trust the local Certificate Authority on the host'
        'install:Install global CLI, man pages, and completions'
        'uninstall:Wipe LaraDock global CLI and configurations'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'laradock commands' commands
            ;;
        args)
            case $line[1] in
                add)
                    # Complete PHP versions as second argument
                    _arguments \
                        '1:Domain Name (e.g. blog.test):' \
                        '2:PHP Version:(php-82 php-84 php-85)'
                    ;;
                remove)
                    # Complete with registered domains from sites.txt
                    local -a domains
                    if [[ -f /home/kirito/laragon/sites.txt ]]; then
                        domains=($(awk -F'(' '{print $1}' /home/kirito/laragon/sites.txt | sed -e 's|^[^/]*//||' | tr -d ' \r\n\t'))
                    fi
                    _arguments "1:Domain:($domains)"
                    ;;
                ssh|restart)
                    # Complete with docker services
                    local -a services
                    services=(php-82 php-84 php-85 nginx postgres redis rabbitmq node)
                    _arguments "1:Service:($services)"
                    ;;
            esac
            ;;
    esac
}

_laradock "$@"
